OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_model_here

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=causal-design-agent

# Railway SQLite pilot: /data must be a verified persistent backend volume.
# Use one backend replica. Changing this path does not migrate existing records.
# For local development, omit this variable to use backend/study_data/study.sqlite.
# Mount the directory so SQLite's -wal and -shm files share the same volume.
STUDY_DB_PATH=/data/study/study.sqlite
